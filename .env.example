# Required
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
TELEGRAM_CHAT_ID=-1001234567890        # the group chat id (negative)

# Recommended (raises GitHub Search API rate limits)
GITHUB_TOKEN=ghp_xxx

# Translation of non-English descriptions (via Ollama chat model).
# Cloud: leave OLLAMA_HOST as-is and set OLLAMA_API_KEY (from ollama.com).
# Local: set OLLAMA_HOST=http://localhost:11434 and leave the key blank.
# Leave OLLAMA_HOST blank to disable translation entirely.
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma3:12b
OLLAMA_API_KEY=

# Optional: only needed if a theme uses rank = "llm" (Claude-based ranking)
ANTHROPIC_API_KEY=

# Optional (defaults to /data — the Railway volume mount)
STATE_DIR=/data
