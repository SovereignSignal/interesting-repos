# Required
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
TELEGRAM_CHAT_ID=-1001234567890        # the group chat id (negative)

# Recommended (raises GitHub Search API rate limits)
GITHUB_TOKEN=ghp_xxx

# Ollama powers LLM curation (rank = "llm" themes) and translation of non-English
# descriptions. Cloud: leave OLLAMA_HOST as-is and set OLLAMA_API_KEY (from
# ollama.com). Local: set OLLAMA_HOST=http://localhost:11434 and leave the key
# blank. Leave OLLAMA_HOST blank to disable both (themes fall back to top-by-stars,
# descriptions shown as-is).
OLLAMA_HOST=https://ollama.com
# Cloud hosted id; the local pull is gemma4:31b (no -cloud). A leftover local tag
# on ollama.com is mapped to {model}-cloud automatically.
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=
# Stronger model(s) for curation scoring + summaries. Comma-separated = ordered
# fallback chain (first reachable wins); the base OLLAMA_MODEL is the final rung.
# Blank => curate with OLLAMA_MODEL. e.g. "deepseek-v3.1:671b,gpt-oss:120b"
OLLAMA_CURATOR_MODEL=deepseek-v3.1:671b,gpt-oss:120b

# Optional (defaults to /data — the Railway volume mount)
STATE_DIR=/data

# Optional: seconds to pause between Telegram messages so the digest trickles out
# instead of flooding the channel with ~10 messages at once (default 20; 0 = no delay)
SEND_DELAY_SECONDS=20

# Slack mirror (optional). When BOTH are set, each digest message is also posted to this
# Slack channel (HTML→mrkdwn). Unset = Telegram-only. Create a Slack app with the
# chat:write scope, install it to the workspace, and invite the bot to the channel.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXXX

# Failure alerts (optional). When set, the bot DMs this Telegram chat id if a run is
# degraded (Ollama unreachable/unauthorized — the silent-failure case), if any theme
# fails, or if the run crashes. Unset = no alerts. Use your personal chat id (not the
# digest group) so alerts reach you directly.
ALERT_CHAT_ID=
